{
  "permissions": {
    "allow": [
      "Bash(bash .claude/check.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git worktree:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(make:*)",
      "Bash(touch .claude/logs/red-phase)",
      "Bash(rm .claude/logs/red-phase)"
    ],
    "ask": [
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git branch -D:*)",
      "Bash(git worktree remove --force:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push minseong main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git diff --no-index:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-main-push.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/quality-gate.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
